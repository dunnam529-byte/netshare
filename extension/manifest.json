{
  "manifest_version": 3,
  "name": "Regnis Portal Admin & Local File Server",
  "version": "1.0.0",
  "description": "Monitors and manages the companion Regnis local server, exposing admin and blocking features.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
