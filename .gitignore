# ==============================================================================
# Regnis - Comprehensive Git Ignore Rules
# Only source code, configuration files, and assets are tracked.
# User uploaded files, SQLite databases, logs, and dependencies are EXCLUDED.
# ==============================================================================

# ── Dependencies & Lock Files ─────────────────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── User Uploaded Files & Media (EXCLUDED) ────────────────────────────────────
uploads/
**/uploads/
**/uploads/*
!**/uploads/.gitkeep
server/uploads/chat/*
server/uploads/pool/*
server/uploads/profiles/*

# ── SQLite Databases & Storage (EXCLUDED) ──────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
regnis.db
regnis.db*
server/regnis.db*
nexusshare.db
nexusshare.db*
server/nexusshare.db*

# ── Environment & Local Secrets ───────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── OS & Editor Generated Files ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/
.idea/

# ── Logs & Temporary Files ───────────────────────────────────────────────────
*.log
logs/
*.tmp
*.temp
